# =========================================================
# SMS Configuration (MSG91 Flow Builder)
# Get your Auth Key from: MSG91 Dashboard → Profile → Authkey
# =========================================================
SMS_TEST_MODE="false"
MSG91_AUTH_KEY="your_msg91_auth_key"

# MSG91 Flow Template IDs
# Create each template in MSG91 → Flow Builder → get the Flow/Template ID
# Variable keys shown below MUST match the placeholders in your template exactly

# Template: Welcome_SMS
# Message: "Welcome to DND Purchase! You can now buy and sell Steel & Cement in just 2 steps. Visit https://dndpurchase.com to get started. - DND Purchase"
# Variables: none
MSG91_TEMPLATE_WELCOME=""

# Template: New_inquiry_alert
# Message: "New inquiry received. Log in to https://dndpurchase.com to submit your offer. Go to 'New Inquiries' and place your bid. - DND Purchase"
# Variables: none
MSG91_TEMPLATE_NEW_INQUIRY=""

# Template: Bidding_Started
# Message: "Bidding is now live for Inquiry ID {#alp#}. Visit https://dndpurchase.com to submit or revise your bid before the bidding window closes. - DND Purchase"
# Variables: alp = inquiryId
MSG91_TEMPLATE_BIDDING_STARTED=""

# Template: New_Offer
# Message: "New offers received for your Inquiry ID {#alp#}. Log in to https://dndpurchase.com and check 'My Inquiries' to view and manage offers. - DND Purchase"
# Variables: alp = inquiryId
MSG91_TEMPLATE_NEW_OFFER=""

# Template: Offer_Accepted_Buyer
# Message: "You have accepted Offer ID {#alp#}. Connect directly with the seller to finalize shipment & billing details: www.dndpurchase.com - DND Purchase"
# Variables: alp = offerId
MSG91_TEMPLATE_OFFER_ACCEPTED_BUYER=""

# Template: Offer_Accepted_Seller
# Message: "Congratulations! Your Offer ID {#var#} has been accepted by the buyer. Please connect with them to arrange delivery: www.dndpurchase.com - DND Purchase"
# Variables: var = offerId
MSG91_TEMPLATE_OFFER_ACCEPTED_SELLER=""

# Template: Offer_Rejected_Seller
# Message: "Your Offer ID {#var#} was not accepted this time. Check out other active inquiries on your dashboard: www.dndpurchase.com - DND Purchase"
# Variables: var = offerId
MSG91_TEMPLATE_OFFER_REJECTED_SELLER=""

# Template: Inquiry_closed
# Message: "Inquiry ID {#var#} has been closed or cancelled. Pending offers for this inquiry will no longer be active. - DND Purchase"
# Variables: var = inquiryId
MSG91_TEMPLATE_INQUIRY_CLOSED=""

# Template: Inquiry_deleted (optional — falls back to INQUIRY_CLOSED if left empty)
# Variables: var = inquiryId
MSG91_TEMPLATE_INQUIRY_DELETED=""
